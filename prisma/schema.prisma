generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum NewsMediaType {
  IMAGE
  VIDEO
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  passwordHash       String
  name               String
  role               Role           @default(EDITOR)
  active             Boolean        @default(true)
  mustChangePassword Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt
  refreshTokens      RefreshToken[]
  newsCreated        NewsArticle[]  @relation("NewsCreatedBy")
  newsUpdated        NewsArticle[]  @relation("NewsUpdatedBy")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model LoginAttempt {
  ip          String    @id
  failedCount Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model NewsArticle {
  id                 String   @id @default(cuid())
  // Dirección pública de la noticia: /observatorio/<slug>. No cambia al editar el título.
  slug               String   @unique
  category           String
  categoryLabel      String
  publishedAt        DateTime
  title              String
  subtitle           String
  lead               String?
  pointsLabel        String?
  pointsJson         String   @default("[]")
  eventDetailsLabel  String?
  eventDetailsJson   String?
  cta                String?
  href               String?
  mediaType          NewsMediaType @default(IMAGE)
  // Con mediaType IMAGE es la foto; con VIDEO, la portada opcional del video.
  imageSrc           String?
  imageAlt           String?
  // Con mediaType VIDEO se usa uno de los dos: un video de YouTube o un archivo subido.
  videoYoutubeId     String?
  videoFileSrc       String?
  featured           Boolean  @default(false)
  published          Boolean  @default(true)
  createdById        String?
  createdBy          User?    @relation("NewsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById        String?
  updatedBy          User?    @relation("NewsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([createdById])
}

model Video {
  id          String    @id @default(cuid())
  youtubeId   String
  badge       String    @default("Aula Ciudad")
  title       String
  body        String
  href        String
  thumbnail   String?
  publishedAt DateTime?
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Thermometer {
  id                String   @id @default("default")
  activeIndex       Int
  activeTitle       String
  activeDescription String
  updatedAt         DateTime @updatedAt
}
