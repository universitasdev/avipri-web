# Copiar a .env y rellenar. No uses aquí los mismos valores reales de producción
# (Netlify Secrets Scanning fallaría el build).

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"

# proyecto:region:instancia (consola Cloud SQL → Conexiones → Nombre de la conexión)
INSTANCE_CONNECTION_NAME=""

# Mínimo 32 caracteres. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
AUTH_REFRESH_SECRET=""

ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

YOUTUBE_API_KEY=""
PLAYLIST_ID=""

# Cloud Storage + misma SA con roles Storage Object Admin y Cloud SQL Client
GCS_BUCKET=""
GCS_PROJECT_ID=""
GCS_CLIENT_EMAIL=""
GCS_PRIVATE_KEY=""
