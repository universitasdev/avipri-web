# Producción (Cloud SQL). Ejemplo:
# DATABASE_URL="postgresql://pdul_app:CONTRASEÑA@IP:5432/db_pdul?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/db_pdul?sslmode=require"

# Netlify / Cloud SQL Connector (sin depender de redes autorizadas por IP).
# Formato: proyecto:region:instancia  — confirma la región en la consola de Cloud SQL.
# INSTANCE_CONNECTION_NAME="agente-manual-contrataciones:us-central1:cluster-produccion-01"
INSTANCE_CONNECTION_NAME=""

# Mínimo 32 caracteres aleatorios. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
AUTH_REFRESH_SECRET=""

ADMIN_EMAIL="editora@pdul.online"
ADMIN_PASSWORD=""
ADMIN_NAME="Editora PDUL"

# YouTube Data API v3 — Aula Ciudad (playlist pública)
# No pegues la key real en este archivo; va solo en .env
YOUTUBE_API_KEY=""
PLAYLIST_ID="PLRJBaSLMa1H0_4vzPAmrSDy-02VoGdW8_"

# Google Cloud Storage — imágenes de noticias
# Bucket: avipri-pdul-imagenes
# La misma service account debe tener:
# - Storage Object Admin (subidas)
# - Cloud SQL Client (conector en Netlify)
GCS_BUCKET="avipri-pdul-imagenes"
GCS_PROJECT_ID="agente-manual-contrataciones"
GCS_CLIENT_EMAIL=""
GCS_PRIVATE_KEY=""
